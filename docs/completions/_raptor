#compdef raptor
_raptor() {
  local -a cmds
  cmds=(advise analytic compare completion config convert describe diff doctor estimate explain extract fev fit get gui help info mcp optimise render report run schema sensitivity set simulate spf step sweep tables validate whatif)
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
  else
    _files
  fi
}
_raptor "$@"
