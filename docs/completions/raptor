_raptor() {
  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="" opts="" i
  for ((i=1;i<COMP_CWORD;i++)); do
    case "${COMP_WORDS[i]}" in -*) ;; *) cmd="${COMP_WORDS[i]}"; break;; esac
  done
  if [[ -z "$cmd" ]]; then
    COMPREPLY=( $(compgen -W "advise analytic compare completion config convert describe diff doctor estimate explain extract fev get gui help info mcp optimise render report run schema sensitivity set simulate spf step sweep tables validate whatif --color --config --debug --dev-features --help --log-file --log-level --no-config --quiet --verbose --version" -- "$cur") ); return
  fi
  case "$cmd" in
    advise) opts="--format --help --list-rules --min-severity --only --simulate --skip --strict --target --why" ;;
    analytic) opts="--at --bx --dependencies --equation --format --help --hierarchy --ignore --ignore-repairs --importance --max-bdd-nodes --max-variables --mode --no-importance --ods --phase --progress --standby --tau --times --xlsx" ;;
    compare) opts="--analysis --format --help --importance --jobs --length --max-trials --metric --min-trials --precision --precision-batch --precision-metric --runs --save-model --seed --set --set-file --stats-start --stop --timeout --weak-type" ;;
    completion) opts="--help" ;;
    config) opts="--help" ;;
    convert) opts="--allow-lossy --help --to" ;;
    describe) opts="--element --format --help" ;;
    diff) opts="--all --exit-code --format --help --ignore --match --only" ;;
    doctor) opts="--format --help" ;;
    estimate) opts="--format --help --length --runs" ;;
    explain) opts="--below --capacity-rule --chart --chart-svg --format --help --jobs --list-charts --runs --seed --story --top --year-length --year-offset --yearly" ;;
    extract) opts="--deps --format --help --hierarchy --output --pools --report-hazards --streams --treat" ;;
    fev) opts="--capacity --criticality --cycle --fail --format --help --log --phase --repair --script" ;;
    get) opts="--format --help" ;;
    gui) opts="--help --new --theme" ;;
    help) opts="--help" ;;
    info) opts="--element --format --help" ;;
    mcp) opts="" ;;
    optimise) opts="--help" ;;
    render) opts="--help --highlight --level --max-px --no-annotations --output --theme --zoom-to" ;;
    report) opts="--format --help --report --workspace" ;;
    run) opts="--analysis --deps --format --help --hierarchy --importance --jobs --json --legacy-names --length --max-trials --metrics --min-trials --output --pools --precision --precision-batch --precision-metric --progress --report --runs --save-model --seed --set --set-file --stats-start --stop --streams --strict --timeout --treat --weak-type --workspace" ;;
    schema) opts="--help --output" ;;
    sensitivity) opts="--format --help --jobs --metric --seed --top --trials" ;;
    set) opts="--backup --help --in-place --output --set-file" ;;
    simulate) opts="--analysis --deps --format --help --hierarchy --importance --jobs --json --legacy-names --length --max-trials --metrics --min-trials --output --pools --precision --precision-batch --precision-metric --progress --report --runs --save-model --seed --set --set-file --stats-start --stop --streams --strict --timeout --treat --weak-type --workspace" ;;
    spf) opts="--criticality --format --help --output" ;;
    step) opts="--break --events --fine --format --help --run --until" ;;
    sweep) opts="--analysis --format --help --importance --jobs --length --max-trials --metric --min-trials --precision --precision-batch --precision-metric --runs --save-model --seed --set --set-file --stats-start --stop --timeout --vary --weak-type" ;;
    tables) opts="--analysis --format --help --importance --jobs --length --list --max-trials --min-trials --output --precision --precision-batch --precision-metric --run --runs --save-model --seed --set --set-file --stats-start --stop --table --timeout --weak-type" ;;
    validate) opts="--format --help --strict" ;;
    whatif) opts="--change --change-file --format --help --jobs --name --note --precision --requirement --save --seed --trials" ;;
  esac
  COMPREPLY=( $(compgen -f -W "$opts" -- "$cur") )
}
complete -o filenames -F _raptor raptor
