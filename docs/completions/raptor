_raptor() {
  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="" opts="" i
  for ((i=1;i<COMP_CWORD;i++)); do
    case "${COMP_WORDS[i]}" in -*) ;; *) cmd="${COMP_WORDS[i]}"; break;; esac
  done
  if [[ -z "$cmd" ]]; then
    COMPREPLY=( $(compgen -W "advise analytic compare completion config convert declassify describe diff doctor edit estimate explain extract fev fit get gui health help history import-table info library mcp optimise recommend register-file-types render report run schema sensitivity set simulate spf step sweep tables tags validate whatif --color --config --debug --dev-features --help --log-file --log-level --no-config --quiet --verbose --version" -- "$cur") ); return
  fi
  case "$cmd" in
    advise) opts="--format --help --ignore --jobs --list-rules --min-severity --only --progress --reason --restore --simulate --skip --strict --target --why" ;;
    analytic) opts="--at --bx --dependencies --equation --format --help --hierarchy --ignore --ignore-repairs --importance --max-bdd-nodes --max-variables --mode --no-importance --ods --phase --progress --standby --tau --times --xlsx" ;;
    compare) opts="--analysis --block-streams --by-hierarchy --format --help --importance --jobs --length --max-trials --metric --min-trials --precision --precision-batch --precision-confidence --precision-metric --runs --save-model --seed --set --set-file --stats-start --stop --timeout --weak-type" ;;
    completion) opts="--help" ;;
    config) opts="--help" ;;
    convert) opts="--allow-lossy --dry-run --format --help --no-sidecar --normalize-out --report --strict --to" ;;
    declassify) opts="--annotations --help --keep-advisor --keep-comments --keep-metadata --keep-names --keep-rates" ;;
    describe) opts="--element --format --help" ;;
    diff) opts="--all --exit-code --format --help --ignore --match --only" ;;
    doctor) opts="--format --help" ;;
    edit) opts="--help" ;;
    estimate) opts="--format --help --length --runs" ;;
    explain) opts="--analysis --below --capacity-rule --chart --chart-fold --chart-min-share --chart-page --chart-run --chart-svg --compare-to --depth --format --help --hierarchies --hierarchy --importance --jobs --list-charts --no-delivered --progress --report --report-include --runs --sankey --seed --story --target --timeout --top --y-floor --year-length --year-offset --yearly" ;;
    extract) opts="--deps --format --help --hierarchy --output --pools --report-hazards --streams --treat" ;;
    fev) opts="--capacity --criticality --cycle --fail --format --help --log --phase --repair --script" ;;
    fit) opts="--block --format --help --law --quantile --repair" ;;
    get) opts="--format --help" ;;
    gui) opts="--help --new --theme" ;;
    health) opts="--format --help" ;;
    help) opts="--help" ;;
    history) opts="--describe --description --description-file --force --format --help --label --output --restore --snapshot" ;;
    import-table) opts="--format --help --in-place --sheet" ;;
    info) opts="--element --format --help" ;;
    library) opts="--help" ;;
    mcp) opts="" ;;
    optimise) opts="--help" ;;
    recommend) opts="--format --help --jobs --min-gain --progress --run --seed --timeout --top --trials" ;;
    register-file-types) opts="--dry-run --force --help --unregister" ;;
    render) opts="--capacity-rule --help --highlight --jobs --layer --level --max-px --no-annotations --output --seed --theme --trials --zoom-to" ;;
    report) opts="--format --help --report --workspace" ;;
    run) opts="--analysis --block-streams --deps --format --help --hierarchy --importance --jobs --json --legacy-names --length --max-trials --metrics --min-trials --output --pools --precision --precision-batch --precision-confidence --precision-metric --progress --report --runs --save-model --seed --set --set-file --stats-start --stop --streams --strict --timeout --treat --weak-type --workspace" ;;
    schema) opts="--help --output" ;;
    sensitivity) opts="--format --help --jobs --metric --progress --seed --timeout --top --trials" ;;
    set) opts="--backup --help --in-place --output --set-file" ;;
    simulate) opts="--analysis --block-streams --deps --format --help --hierarchy --importance --jobs --json --legacy-names --length --max-trials --metrics --min-trials --output --pools --precision --precision-batch --precision-confidence --precision-metric --progress --report --runs --save-model --seed --set --set-file --stats-start --stop --streams --strict --timeout --treat --weak-type --workspace" ;;
    spf) opts="--criticality --format --help --output" ;;
    step) opts="--break --events --fine --format --help --run --until" ;;
    sweep) opts="--analysis --block-streams --format --help --importance --jobs --length --max-trials --metric --min-trials --precision --precision-batch --precision-confidence --precision-metric --runs --save-model --seed --set --set-file --stats-start --stop --timeout --vary --weak-type" ;;
    tables) opts="--analysis --block-streams --capacity-rule --case-sensitive --column --drivers --find --format --help --importance --in-place --jobs --length --list --max-trials --min-trials --output --precision --precision-batch --precision-confidence --precision-metric --replace --run --runs --save-model --seed --set --set-file --stats-start --stop --table --timeout --weak-type --whole" ;;
    tags) opts="--help" ;;
    validate) opts="--format --help --strict" ;;
    whatif) opts="--change --change-file --format --help --jobs --name --note --precision --progress --requirement --save --seed --timeout --trials" ;;
  esac
  COMPREPLY=( $(compgen -f -W "$opts" -- "$cur") )
}
complete -o filenames -F _raptor raptor
